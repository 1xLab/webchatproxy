[Unit]
Description=WebChatProxy Google Antigravity Account Pool
After=network-online.target webchat-antigravity@1.service webchat-antigravity@2.service webchat-antigravity@3.service webchat-antigravity@4.service webchat-antigravity@5.service webchat-antigravity@6.service webchat-antigravity@7.service webchat-antigravity@8.service webchat-antigravity@9.service webchat-antigravity@10.service
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANTIGRAVITY_POOL_HOST=127.0.0.1
Environment=ANTIGRAVITY_POOL_PORT=3240
Environment=ANTIGRAVITY_POOL_RUNTIME_DIR=/home/agent/webchatproxy/runtime/antigravity-pool
EnvironmentFile=-/home/agent/webchatproxy/runtime/antigravity-pool.env
ExecStart=/bin/bash /home/agent/webchatproxy/providers/antigravity/engine/start-pool.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
