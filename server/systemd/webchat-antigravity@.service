[Unit]
Description=WebChatProxy Google Antigravity Account %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/agent/.agy/account-%i
Environment=ANTIGRAVITY_HOST=127.0.0.1
Environment=ANTIGRAVITY_INSTANCE=%i
Environment=ANTIGRAVITY_RUNTIME_DIR=/home/agent/webchatproxy/runtime/antigravity-%i
Environment=ANTIGRAVITY_API_KEY_FILE=/home/agent/webchatproxy/runtime/antigravity-%i/.api-key
Environment=ANTIGRAVITY_CONTEXT_DIR=/home/agent/webchatproxy/runtime/antigravity-%i/context
EnvironmentFile=-/home/agent/webchatproxy/runtime/antigravity-%i.env
ExecStart=/bin/bash /home/agent/webchatproxy/providers/antigravity/engine/start.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
