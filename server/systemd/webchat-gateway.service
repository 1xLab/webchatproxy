[Unit]
Description=webchatproxy ChatGPT Web Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy
Environment=HOME=/home/agent
Environment=WEBCHAT_NOFILE=65535
Environment=WEBCHAT_PROFILE_DIR=/home/agent/webchatproxy/browser-profile
Environment=WEBCHAT_RUNTIME_DIR=/home/agent/webchatproxy/runtime
Environment=WEBCHAT_HOST=127.0.0.1
Environment=WEBCHAT_PORT=3210
Environment=WEBCHAT_ENGINE_VENV=/home/agent/webchatproxy/.venv-chatgpt
PIDFile=/home/agent/webchatproxy/.webchat-gateway.pid
ExecStart=/home/agent/webchatproxy/start.sh start
ExecStop=/home/agent/webchatproxy/start.sh stop
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStartSec=90
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
