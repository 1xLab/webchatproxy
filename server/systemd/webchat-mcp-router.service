[Unit]
Description=WebChatProxy Provider-Neutral MCP Router
After=network-online.target webchat-gateway.service webchat-deepseek.service webchat-kimi.service
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy
Environment=HOME=/home/agent
Environment=WEBCHAT_ROUTER_MCP_LOG_LEVEL=INFO
EnvironmentFile=-/home/agent/webchatproxy/runtime/mcp-router.env
ExecStart=/home/agent/webchatproxy/.venv-chatgpt/bin/python /home/agent/webchatproxy/mcp/server.py --transport sse --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
