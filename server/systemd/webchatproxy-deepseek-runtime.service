[Unit]
Description=WebChatProxy DeepSeek Internal Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy/server
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DEEPSEEK_HOST=127.0.0.1
Environment=DEEPSEEK_PORT=3320
Environment=DS_CDP=http://127.0.0.1:9333
Environment=DS_DATA_DIR=/home/agent/webchatproxy/runtime/deepseek
Environment=DS_CHROME_PROFILE=/home/agent/webchatproxy/browser-profile-deepseek
EnvironmentFile=-/home/agent/webchatproxy/runtime/deepseek.env
ExecStart=/bin/bash /home/agent/webchatproxy/server/providers/deepseek/engine/start.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
