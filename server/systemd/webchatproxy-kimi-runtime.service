[Unit]
Description=WebChatProxy Kimi Internal Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/webchatproxy/server
Environment=HOME=/home/agent
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=KIMI_HOST=127.0.0.1
Environment=KIMI_PORT=3330
Environment=KIMI_RUNTIME_DIR=/home/agent/webchatproxy/runtime/kimi
EnvironmentFile=-/home/agent/webchatproxy/runtime/kimi.env
ExecStart=/bin/bash /home/agent/webchatproxy/server/providers/kimi/engine/start.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
